# Contrato Fusible desplegado en testnet (administra todos los fusibles)
VITE_CONTRACT_ID=C...

# SAC del XLM nativo en testnet: el activo que mueven los fusibles
VITE_TOKEN_ID=C...

# Llaves de DEMOSTRACIÓN, solo testnet.
# Quedan embebidas en el bundle del navegador: cualquiera puede leerlas.
# Es intencional y seguro aquí — son fondos de prueba sin valor, y sirve para
# enseñar el punto del producto: la llave del agente es pública y aun así no
# puede exceder el tope ni pagar fuera de la lista, porque quien lo impide es
# el contrato. Nunca uses una llave de mainnet en un front.
VITE_DUENO_ID=G...
VITE_DUENO_SECRET=S...
VITE_AGENTE_ID=G...
VITE_AGENTE_SECRET=S...

# Destinos que se ofrecen como permitidos al crear un fusible
VITE_DESTINO_1=G...
VITE_DESTINO_2=G...
