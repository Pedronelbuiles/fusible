# Contrato Fusible desplegado en testnet
VITE_CONTRACT_ID=C...
VITE_AGENTE_ID=G...

# Llave del agente de DEMOSTRACIÓN, solo testnet.
# Queda embebida en el bundle del navegador: cualquiera puede leerla.
# Es intencional y seguro aquí: son fondos de prueba sin valor, y el
# contrato limita qué puede hacer esa llave. Nunca uses una llave de
# mainnet en un front.
VITE_AGENTE_SECRET=S...

# Destinos permitidos en el fusible desplegado
VITE_DESTINO_1=G...
VITE_DESTINO_2=G...
